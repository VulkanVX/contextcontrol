<UserControl
    x:Class="ContextControl.Workbench.Views.ThemeSettingsWindowParts.PromptWindowSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <Border Classes="rule-card" Padding="10,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="field-label" Text="Autoswitch to Chat when mode changes" />
          <TextBlock
              Classes="muted"
              Text="Local, Codex CLI, and ImageGen prompt buttons can bring the shared chat transcript forward automatically."
              TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox
            Grid.Column="1"
            Classes="appearance-toggle"
            Content="On/Off"
            IsChecked="{Binding AutoSwitchPromptModesToChat, Mode=TwoWay}"
            VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Classes="rule-card" Padding="14,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <TextBlock Classes="field-label" Text="Floating Chat Monitor" />
          <TextBlock Classes="muted" Text="A compact, draggable window for your chats. See live status, open a conversation, or reply with files without bringing the full workbench forward." TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="New chats and replies appear automatically. Right-click a chat in history to add or remove it. Removing a monitor row keeps the conversation." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10">
          <ToggleSwitch IsChecked="{Binding IsChatMonitorEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" VerticalAlignment="Top" />
          <CheckBox IsChecked="{Binding IsChatProgressPanelEnabled, Mode=TwoWay}" Content="Progress panel above terminal" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="rule-card" Padding="14,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6">
          <TextBlock Classes="field-label" Text="Google research for local models" />
          <TextBlock Classes="muted" Text="Let any installed chat model search Google, choose pages, and answer with sources. Each research chat uses its own tab in Browser. Google may ask for consent or verification there." TextWrapping="Wrap" />
          <CheckBox Content="Show browser actions and page previews in chat" IsChecked="{Binding ContextControl.IsBrowserActionPreviewEnabled, Mode=TwoWay}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ContextControl.IsGoogleSearchEnabled, Mode=TwoWay}" OnContent="Auto" OffContent="Off" VerticalAlignment="Top" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
