<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContextControl.Workbench.Views.ThemeSettingsWindowParts.LlmsSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ContextControl.Workbench.Controls"
    xmlns:vm="clr-namespace:ContextControl.Workbench.ViewModels"
>
          <Grid x:Name="LlmsPageRoot" RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel>
                <TextBlock Classes="settings-title" Text="Local LLM roles" />
                <TextBlock Classes="muted" Text="Defaults used by the CC-native chat capsule builder" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ContextControl.LocalLlmStatus}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                controls:HoverScrollbarBehavior.IsEnabled="True"
                controls:HoverScrollbarBehavior.ReserveRight="12">
              <StackPanel Spacing="8">
                <Border Classes="rule-card">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="settings-title" Text="Chat actions and game creation" />
                    <TextBlock Classes="muted" Text="Type / in the composer to choose research, games, images or project coding explicitly." TextWrapping="Wrap" />
                    <Button Content="Browse actions and examples" Command="{Binding ContextControl.ShowActionsCommand}" HorizontalAlignment="Left" />
                    <CheckBox x:Name="AutoCheckGamesToggle" Content="Run and repair generated browser games" IsChecked="{Binding ContextControl.AutoCheckGames, Mode=TwoWay}" />
                    <TextBlock Classes="muted" Text="Check final HTML in the offline Game Lab, collect startup/input errors and try up to two model repairs. Each version is saved. Stop cancels repair; passing these checks still requires a gameplay test." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="rule-card" x:Name="ResourceAdaptationCard">
                  <StackPanel Spacing="8">
                    <CheckBox x:Name="AutoAdaptModelsToggle" Content="Auto adapt to hardware" IsChecked="{Binding ContextControl.AutoAdaptLocalModels, Mode=TwoWay}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ContextControl.HardwareSummary}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ContextControl.ResourceModeSummary}" />
                    <TextBlock Classes="field-label" Text="Context mode" />
                    <ComboBox x:Name="ContextModePicker" ItemsSource="{Binding ContextControl.ContextModeOptions}" SelectedItem="{Binding ContextControl.LocalContextMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ContextControl.ContextModeDescription}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ContextControl.LastContextDecision}" />
                    <StackPanel Spacing="8" IsEnabled="{Binding ContextControl.AutoAdaptLocalModels}">
                      <WrapPanel>
                        <CheckBox Content="GPU layers" IsChecked="{Binding ContextControl.AutoModelGpuLayers, Mode=TwoWay}" Margin="0,0,16,0" ToolTip.Tip="Estimate a split for managed GGUF runtimes. Ollama uses its own dynamic GPU allocation." />
                        <CheckBox Content="Context size" IsChecked="{Binding ContextControl.AutoModelContext, Mode=TwoWay}" Margin="0,0,16,0" />
                        <CheckBox Content="CPU threads" IsChecked="{Binding ContextControl.AutoModelThreads, Mode=TwoWay}" />
                      </WrapPanel>
                      <WrapPanel>
                        <StackPanel Spacing="3" Margin="0,0,16,0">
                          <TextBlock Classes="field-label" Text="Adaptive / custom ceiling" />
                          <NumericUpDown Value="{Binding ContextControl.AutoModelMaxContext, Mode=TwoWay}" Minimum="1024" Maximum="1048576" Increment="1024" Width="170" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,16,0">
                          <TextBlock Classes="field-label" Text="RAM headroom (GiB)" />
                          <NumericUpDown Value="{Binding ContextControl.AutoModelRamReserve, Mode=TwoWay}" Minimum="1" Maximum="64" Increment="1" Width="170" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                          <TextBlock Classes="field-label" Text="VRAM headroom (GiB)" />
                          <NumericUpDown Value="{Binding ContextControl.AutoModelVramReserve, Mode=TwoWay}" Minimum="0.25" Maximum="32" Increment="0.25" Width="170" />
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Headroom (previously Keep free) leaves memory for Windows and other apps. The planner subtracts it from available memory; it does not allocate memory or enforce a hard runtime limit. For example, 40 GiB available minus 4 GiB headroom gives a 36 GiB budget." />
                    <controls:LocalResourceStatusPanel />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Manual values are kept when Auto is off. Ollama adapts new requests; managed servers adapt on Start. External servers and specialized image runtimes keep their own allocation settings. Estimates do not guarantee model compatibility or speed." />
                  </StackPanel>
                </Border>
                <Border Classes="rule-card">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="settings-title" Text="Local model servers" />
                      <Button Grid.Column="1" Classes="rule-mini primary" Content="Apply and connect" Command="{Binding ContextControl.ApplyRuntimeConnectionsCommand}" />
                    </Grid>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Connect llama.cpp, LM Studio, KoboldCpp, Transformers, or a compatible server such as vLLM, SGLang, LocalAI, MLX or MLC. Connected models appear in LLMs and the chat model selector. Start and load a model in its runtime first." />
                    <ItemsControl ItemsSource="{Binding ContextControl.LocalRuntimeProfiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalRuntimeProfileViewModel">
                          <Border Classes="rule-card" Margin="0,4">
                            <StackPanel Spacing="5">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
                              </Grid>
                              <TextBox Text="{Binding Endpoint}" Watermark="http://127.0.0.1:8080/v1" />
                              <Grid ColumnDefinitions="*,150" ColumnSpacing="8">
                                <TextBox Text="{Binding ApiKeyEnvironmentVariable}" Watermark="API key environment variable (optional)" />
                                <NumericUpDown Grid.Column="1" Value="{Binding ContextTokens}" IsEnabled="{Binding IsContextManual}" Minimum="1024" Maximum="1048576" Increment="1024" ToolTip.Tip="Manual context budget. Managed servers use it on the next Start; external servers must be configured separately. Auto preserves this value." />
                              </Grid>
                              <StackPanel IsVisible="{Binding CanManage}" Spacing="5">
                                <CheckBox Content="Use hardware adaptation for this runtime" IsChecked="{Binding AdaptToHardware, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                  <TextBox Text="{Binding ModelPath}" Watermark="GGUF file path, or Transformers model folder / Hugging Face ID" />
                                  <Button Grid.Column="1" Classes="rule-mini" Content="Browse GGUF" IsVisible="{Binding SupportsGpuLayers}" Click="OnRuntimeModelBrowseClick" />
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                  <Button Classes="rule-mini" Content="Install / update runtime" Command="{Binding InstallCommand}" Margin="0,0,6,0" />
                                  <Button Classes="rule-mini primary" Content="Start model" Command="{Binding StartCommand}" Margin="0,0,6,0" />
                                  <Button Classes="rule-mini" Content="Stop / cancel" Command="{Binding StopCommand}" Margin="0,0,6,0" />
                                  <NumericUpDown IsVisible="{Binding SupportsGpuLayers}" Value="{Binding GpuLayers}" IsEnabled="{Binding IsGpuManual}" Minimum="0" Maximum="999" Increment="1" Width="100" ToolTip.Tip="GPU layers: 0 uses CPU and saves VRAM; increase gradually for GPU acceleration." />
                                </WrapPanel>
                                <WrapPanel>
                                  <TextBlock Classes="field-label" Text="CPU threads" VerticalAlignment="Center" Margin="0,0,6,0" />
                                  <NumericUpDown Value="{Binding CpuThreads}" IsEnabled="{Binding IsThreadsManual}" Minimum="0" Maximum="1024" Increment="1" Width="100" ToolTip.Tip="Manual CPU threads; 0 uses the runtime default." />
                                  <Button Classes="rule-mini" Content="Preview allocation" Command="{Binding PreviewCommand}" Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding AdaptationSummary}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="One managed model runs at a time. Stop releases its memory. Transformers stays on CPU; its model memory is unverified until loaded. A Hugging Face ID downloads weights on Start." />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="rule-card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <StackPanel>
                        <TextBlock Classes="settings-title" Text="Ollama model storage" />
                        <TextBlock Classes="muted" Text="{Binding ContextControl.OllamaModelsDirectoryStatus}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="rule-mini" MinHeight="24" Content="Browse" Click="OnOllamaModelsBrowseClick" />
                      <Button Grid.Column="2" Classes="rule-mini primary" MinHeight="24" Content="Apply" Command="{Binding ContextControl.ApplyOllamaModelsDirectoryCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="Models directory" VerticalAlignment="Center" />
                      <TextBox
                          Grid.Column="1"
                          Classes="rule-add"
                          Text="{Binding ContextControl.OllamaModelsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Watermark="D:\Ollama\models" />
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Classes="path-text"
                        TextWrapping="Wrap"
                        Text="Sets OLLAMA_MODELS for future downloads. Restart Ollama after changing this path." />
                  </Grid>
                </Border>

                <Border Classes="rule-card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Classes="settings-title" Text="Hugging Face token" />
                        <TextBlock Classes="muted" Text="{Binding ContextControl.HuggingFaceTokenStatus}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="rule-mini primary"
                          MinHeight="24"
                          MinWidth="64"
                          Content="Tutorial"
                          Click="OnHuggingFaceTokenTutorialClick" />
                      <Button
                          Grid.Column="2"
                          Classes="rule-mini"
                          MinHeight="24"
                          MinWidth="64"
                          Content="Tokens"
                          Click="OnHuggingFaceTokenPageClick" />
                      <Button
                          Grid.Column="3"
                          Classes="rule-mini"
                          MinHeight="24"
                          MinWidth="64"
                          Content="Docs"
                          Click="OnHuggingFaceTokenDocsClick" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="HF token" VerticalAlignment="Center" />
                      <TextBox
                          Grid.Column="1"
                          Classes="rule-add"
                          Text="{Binding ContextControl.HuggingFaceToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Watermark="hf_..." />
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Classes="path-text"
                        TextWrapping="Wrap"
                        Text="Used as HF_TOKEN/HUGGINGFACE_HUB_TOKEN for Diffusers model downloads and first-run generation." />
                  </Grid>
                </Border>

                <Border Classes="rule-card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                      <StackPanel>
                        <TextBlock Classes="settings-title" Text="Codex CLI" />
                        <TextBlock Classes="muted" Text="{Binding ContextControl.CodexSetupSummary}" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="rule-mini primary"
                          MinHeight="24"
                          MinWidth="64"
                          Content="{Binding ContextControl.CodexInstallButtonLabel}"
                          Command="{Binding ContextControl.InstallCodexCommand}" />
                      <Button
                          Grid.Column="2"
                          Classes="rule-mini"
                          MinHeight="24"
                          Content="Guide"
                          Command="{Binding ContextControl.OpenCodexGuideCommand}" />
                      <Button
                          Grid.Column="3"
                          Classes="rule-mini primary"
                          MinHeight="24"
                          MinWidth="64"
                          Content="{Binding ContextControl.CodexLoginButtonLabel}"
                          Command="{Binding ContextControl.OpenCodexLoginCommand}" />
                      <Button
                          Grid.Column="4"
                          Classes="rule-mini"
                          MinHeight="24"
                          Content="Logout"
                          Command="{Binding ContextControl.LogoutCodexCommand}" />
                      <Button
                          Grid.Column="5"
                          Classes="rule-mini"
                          MinHeight="24"
                          Content="Refresh"
                          Command="{Binding ContextControl.RefreshCodexStatusCommand}" />
                      <Button
                          Grid.Column="6"
                          Classes="rule-mini"
                          MinHeight="24"
                          Content="Doctor"
                          Command="{Binding ContextControl.RunCodexDoctorCommand}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Classes="path-text"
                        Text="{Binding ContextControl.CodexStatus}" />
                  </Grid>
                </Border>

                <Border Classes="rule-card">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="File request model" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ContextControl.LocalModelIdOptions}" SelectedItem="{Binding ContextControl.FileRequestModelId, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="Patch write model" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ContextControl.LocalModelIdOptions}" SelectedItem="{Binding ContextControl.PatchWriteModelId, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="Patch review model" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ContextControl.LocalModelIdOptions}" SelectedItem="{Binding ContextControl.PatchReviewModelId, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="180,*" ColumnSpacing="10">
                      <TextBlock Classes="field-label" Text="General chat model" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" Classes="theme-picker" ItemsSource="{Binding ContextControl.LocalModelIdOptions}" SelectedItem="{Binding ContextControl.ChatModelId, Mode=TwoWay}" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="rule-card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Classes="settings-title" Text="Skillbook roots" />
                    <TextBlock Grid.Row="1" Classes="path-text" Text="{Binding ContextControl.SkillbookGlobalPath}" />
                    <TextBlock Grid.Row="2" Classes="path-text" Text="{Binding ContextControl.SkillbookProjectPath}" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
</UserControl>
