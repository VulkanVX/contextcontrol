<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ContextControl.Workbench.ViewModels"
    x:Class="ContextControl.Workbench.Controls.LocalResourceStatusPanel">
  <StackPanel Spacing="5">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Resources" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="ResourceModelPicker" ItemsSource="{Binding ContextControl.LocalLlmModels}"
          SelectedItem="{Binding ContextControl.SelectedResourceModel, Mode=TwoWay}" HorizontalAlignment="Stretch"
          MaxDropDownHeight="300" ToolTip.Tip="Preview any catalog model without downloading or changing the chat model.">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LocalLlmModelViewModel"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Classes="rule-mini" Content="Refresh" Click="OnRefreshClick" />
    </Grid>
    <TextBlock Classes="muted" Text="{Binding ContextControl.ResourceBudgetSummary}" TextWrapping="Wrap" />
    <TextBlock x:Name="ActualAllocation" Text="{Binding ContextControl.ResourceAllocationSummary}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" Text="{Binding ContextControl.ResourceEstimateSummary}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" x:Name="ContextCapacity" Text="{Binding ContextControl.ResourceContextSummary}" TextWrapping="Wrap" />
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="0,8,0,0" Margin="0,4,0,0">
      <StackPanel Spacing="5">
        <WrapPanel Orientation="Horizontal">
          <CheckBox x:Name="MeasuredPerformanceToggle" Content="Use measured speed settings" IsChecked="{Binding ContextControl.UseMeasuredLocalPerformance, Mode=TwoWay}" Margin="0,0,12,0" />
          <Button x:Name="TuneModelButton" Classes="rule-mini" Content="Tune speed" Click="OnTuneClick" Margin="0,0,6,0"
              ToolTip.Tip="Compare CPU threads and supported draft lengths on short test prompts. Up to 15 minutes; real chats take priority." />
          <Button Classes="rule-mini" Content="Cancel" Click="OnCancelTuneClick" IsVisible="{Binding ContextControl.IsPerformanceTuning}" />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding ContextControl.IsPerformanceTuning}" />
        <TextBlock x:Name="PerformanceSummary" Classes="muted" Text="{Binding ContextControl.SavedPerformanceSummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ContextControl.PerformanceStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
