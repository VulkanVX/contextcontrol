<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContextControl.Workbench.Views.MainWindowParts.ConversationPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ContextControl.Workbench.Controls"
    xmlns:svc="clr-namespace:ContextControl.Workbench.Services"
    xmlns:vm="clr-namespace:ContextControl.Workbench.ViewModels"
>
            <Border
                Grid.Row="2"
                Classes="editor-body chat-page"
                Padding="0"
                ClipToBounds="True"
                MinHeight="0"
                IsVisible="{Binding IsConversationMode}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" MinHeight="0" ClipToBounds="True">
                <Grid
                    x:Name="ChatHistoryHoverShell"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Classes="chat-history-hover-shell"
                    Width="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True"
                    PointerEntered="OnChatHistoryHoverEntered"
                    PointerExited="OnChatHistoryHoverExited">
                  <Border
                      x:Name="ChatHistoryPanel"
                      Classes="chat-history-panel"
                      Opacity="0"
                      IsHitTestVisible="False">
                  <Grid RowDefinitions="Auto,*" RowSpacing="7" MinHeight="0">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="cc-chat-role" Text="{Binding ContextControl.ChatHistoryPanelTitle}" />
                        <TextBlock Classes="history-meta" Text="{Binding ContextControl.ChatHistorySummary}" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="cc-prompt-chip"
                          Content="Export"
                          Command="{Binding ContextControl.ExportChatCommand}" />
                      <Button
                          Grid.Column="2"
                          Classes="cc-prompt-chip"
                          Content="New"
                          Command="{Binding ContextControl.NewChatSessionCommand}" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        AllowAutoHide="False">
                      <ItemsControl
                          x:Name="ChatSessionList"
                          Classes="chat-session-list"
                          ItemsSource="{Binding ContextControl.ChatSessions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:ChatSessionViewModel}">
                            <Grid ColumnDefinitions="*,22" ColumnSpacing="3" MinHeight="34" Margin="0,0,0,3">
                              <Button
                                  Classes="chat-session-row"
                                  Classes.active="{Binding IsActive}"
                                  Classes.generating="{Binding IsGenerating}"
                                  Classes.new-response="{Binding ShowNewResponseHighlight}"
                                  VerticalAlignment="Stretch"
                                  Command="{Binding DataContext.ContextControl.SelectChatSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5" RowSpacing="2">
                                  <TextBlock Text="{Binding Title}" Classes="chat-session-title" />
                                  <TextBlock Grid.Column="1" Text="{Binding Activity.ElapsedLabel}" Classes="history-meta" IsVisible="{Binding IsGenerating}" VerticalAlignment="Center" />
                                  <controls:LoadingRingControl
                                      Grid.Column="2"
                                      Classes="chat-session-loader"
                                      IsVisible="{Binding ShowGeneratingLoader}" />
                                  <Border
                                      Grid.Column="2"
                                      Classes="chat-session-unread-dot"
                                      IsVisible="{Binding ShowUnreadDot}" />
                                  <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" IsVisible="{Binding !IsGenerating}" Classes="history-meta chat-session-summary" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Activity.CompactStatus}" Classes="history-meta" IsVisible="{Binding IsGenerating}" />
                                </Grid>
                              </Button>
                              <Button
                                  Grid.Column="1"
                                  Classes="chat-session-remove"
                                  VerticalAlignment="Center"
                                  Content="x"
                                  Command="{Binding DataContext.ContextControl.RemoveChatSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                  </Border>
                  <Border
                      Width="10"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      PointerPressed="OnChatHistoryRailPressed" />
                  <Border
                      Classes="chat-history-trigger-line"
                      Width="1"
                      HorizontalAlignment="Right"
                      ZIndex="1"
                      IsHitTestVisible="False" />
                  <controls:DisclosureArrowControl
                      x:Name="ChatHistoryRailArrow"
                      Classes="chat-history-rail-arrow"
                      ThemeKey="{Binding ThemeKey}"
                      ZIndex="2"
                      PointerPressed="OnChatHistoryRailPressed" />
                </Grid>

                <Grid x:Name="ReasoningSplitGrid" Grid.Column="1" ColumnDefinitions="*,0,0" MinHeight="0" ClipToBounds="True">
                <ScrollViewer
                    x:Name="TranscriptScroll"
                    Grid.Column="0"
                    MinWidth="0"
                    Margin="8"
                    ClipToBounds="True"
                    Classes="chat-message-scroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    AllowAutoHide="False">
                  <controls:ChatTranscriptRenderControl
                      ClipToBounds="True"
                      Items="{Binding ContextControl.ChatMessages}"
                      ThemeKey="{Binding ThemeKey}"
                      UiFontFamily="{Binding UiFontFamily}"
                      CodeFontFamily="{Binding CodeFontFamily}"
                      ChatFontSize="{Binding ChatWindowFontSize}"
                      OpenAttachmentCommand="{Binding OpenAttachmentCommand}"
                      OpenArticleCommand="{Binding ContextControl.OpenResearchArticleCommand}"
                      RunGameCommand="{Binding ContextControl.RunGameCommand}"
                      CopyChatTextCommand="{Binding ContextControl.CopyChatTextCommand}"
                      CreateProjectFromMessageCommand="{Binding ContextControl.CreateProjectFromMessageCommand}"
                      ToggleSnippetCommand="{Binding ContextControl.ToggleSnippetCommand}"
                      CopySnippetCommand="{Binding ContextControl.CopySnippetCommand}"
                      SaveSnippetAsCommand="{Binding ContextControl.SaveSnippetAsCommand}"
                      UseSnippetForCcCommand="{Binding ContextControl.UseSnippetForCcCommand}"
                      PreviewSnippetCommand="{Binding ContextControl.PreviewSnippetCommand}"
                      ApplyPatchCommand="{Binding ContextControl.ApplyPatchCommand}"
                      ApplyAllPatchCommand="{Binding ContextControl.ApplyAllPatchCommand}"
                      OpenPatchPlanFileCommand="{Binding ContextControl.OpenPatchPlanFileCommand}"
                      ToggleThinkingCommand="{Binding ContextControl.ToggleThinkingCommand}"
                      ToggleDiagnosticCommand="{Binding ContextControl.ToggleDiagnosticCommand}" />
                </ScrollViewer>
                <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" IsVisible="{Binding ContextControl.IsReasoningPaneOpen}" />
                <Border Grid.Column="2" MinWidth="220" Classes="rule-card" Padding="10" IsVisible="{Binding ContextControl.IsReasoningPaneOpen}">
                  <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Reasoning · this chat" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="×" Click="OnCloseReasoning" Classes="cc-prompt-chip" ToolTip.Tip="Close reasoning pane" />
                    </Grid>
                    <ScrollViewer x:Name="ReasoningScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnReasoningScrollChanged">
                      <ItemsControl x:Name="ReasoningItems" ItemsSource="{Binding ContextControl.ReasoningMessages}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LocalLlmChatMessageViewModel">
                            <Border Classes="rule-card reasoning-entry" Classes.active="{Binding IsReasoningSelected}" IsVisible="{Binding HasThinking}" Padding="10" Margin="0,0,0,8">
                              <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ReasoningHeader}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReasoningContext}" TextWrapping="Wrap" Classes="muted" />
                                <controls:ReasoningTextBlock Markdown="{Binding ThinkingText}" TextWrapping="Wrap" FontWeight="Normal" FontFamily="{DynamicResource UiFontFamily}" CodeFontFamily="{DynamicResource CodeFontFamily}" FontSize="{Binding DataContext.ChatWindowFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
                </Grid>
                <Border Grid.Column="1" Grid.Row="1" Padding="8,4">
                  <StackPanel Spacing="5">
                    <Expander Header="Browser actions" IsExpanded="{Binding ContextControl.IsBrowserActionPreviewEnabled, Mode=TwoWay}" IsVisible="{Binding BrowserPane.HasResearchTabs}" HorizontalAlignment="Stretch" Background="{DynamicResource ChatSnippetShellBrush}" BorderThickness="0" Padding="0">
                      <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BrowserPane.ResearchTabs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BrowserTabViewModel">
                              <Button Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="112" Padding="10"
                                  Background="{DynamicResource ChatSnippetShellBrush}" BorderBrush="{DynamicResource ChatSnippetBorderBrush}" BorderThickness="1" CornerRadius="10"
                                  Command="{Binding DataContext.BrowserPane.OpenResearchTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip.Tip="Open this working tab in Browser">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                  <Image Source="{Binding ActionPreviewImage}" Width="170" Height="96" Stretch="UniformToFill" />
                                  <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <controls:ActivityLineControl Text="{Binding AgentStatus}" IsActive="{Binding IsAgentWorking}" Height="22" Foreground="{DynamicResource TextPrimaryBrush}" Accent="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding ActionPreview}" FontSize="10" TextWrapping="Wrap" MaxLines="4" Foreground="{DynamicResource TextMutedBrush}" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Expander>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Content="Reasoning ↗" Click="OnOpenReasoning" Classes="cc-prompt-chip" ToolTip.Tip="Open live reasoning, grouped by reply" />
                    <TextBlock Grid.Column="1" Text="{Binding ContextControl.SelectedChatActivity.CompactStatus}" Classes="history-meta" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ContextControl.SelectedChatActivity.ElapsedLabel}" Classes="history-meta" VerticalAlignment="Center" />
                  </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
</UserControl>
