<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContextControl.Workbench.Views.MainWindowParts.WorkspaceHeaderBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ContextControl.Workbench.Controls"
    xmlns:svc="clr-namespace:ContextControl.Workbench.Services"
    xmlns:vm="clr-namespace:ContextControl.Workbench.ViewModels"
>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="40" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Classes="workspace-mode-bar" Padding="6,5">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                <ItemsControl
                    Grid.Column="0"
                    ItemsSource="{Binding WorkspaceModes}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WorkbenchModeOptionViewModel}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button
                          Classes="workspace-mode-button"
                          Classes.active="{Binding IsActive}"
                          Command="{Binding DataContext.SwitchWorkspaceModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <controls:WorkspaceIcon IconKey="{Binding Key}" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Border IsVisible="{Binding IsBrowserOption}" VerticalAlignment="Center">
                        <Button Classes="header-mini" Click="OnResearchActivityClick"
                                IsVisible="{Binding DataContext.BrowserPane.HasActiveAgents, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip.Tip="Active research chats have their own browser tabs. Open a working tab.">
                          <controls:ActivityLineControl Width="128" FontSize="10" Height="22"
                              Text="{Binding DataContext.BrowserPane.AgentActivityLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsActive="{Binding DataContext.BrowserPane.HasActiveAgents, RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="{DynamicResource TextPrimaryBrush}" Accent="{DynamicResource AccentBrush}" />
                        </Button>
                      </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Grid.Column="1"
                    Classes="header-mini workspace-update"
                    Content="{Binding UpdateButtonLabel}"
                    Command="{Binding CheckForUpdatesCommand}"
                    ToolTip.Tip="{Binding UpdateStatusLabel}"
                    VerticalAlignment="Center" />

                <ScrollViewer
                    Grid.Row="1" Grid.ColumnSpan="2"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    controls:HoverScrollbarBehavior.IsEnabled="True"
                    controls:HoverScrollbarBehavior.ReserveBottom="10"
                    IsVisible="{Binding IsBrowserMode}">
                  <ItemsControl ItemsSource="{Binding BrowserPane.Tabs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                        <Border
                            Classes="browser-tab"
                            Classes.active="{Binding IsActive}"
                            PointerPressed="OnBrowserTabPointerPressed">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <StackPanel Spacing="1" MaxWidth="210">
                            <TextBlock
                                Text="{Binding Title}"
                                Classes="browser-tab-title"
                                ToolTip.Tip="{Binding Url}" />
                              <controls:ActivityLineControl Text="{Binding AgentStatus}" IsActive="{Binding IsAgentWorking}" IsVisible="{Binding IsResearch}"
                                  FontSize="9" Height="20" Width="190" Foreground="{DynamicResource TextMutedBrush}" Accent="{DynamicResource AccentBrush}" ToolTip.Tip="{Binding AgentStatus}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Classes="browser-tab-close"
                                Content="x"
                                Click="OnBrowserTabCloseClick"
                                ToolTip.Tip="{Binding CloseToolTip}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsCodeEditorMode}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveDocument.Name}" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ActiveDocument.Path}" Classes="editor-meta" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ActiveDocument.Loc}" Classes="editor-meta loc" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveDocument.Language}" Classes="editor-meta type" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="{Binding ActiveDocument.Version}" Classes="editor-meta version" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="{Binding ActiveDocument.Bytes}" Classes="editor-meta bytes" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Grid.Column="5" Text="{Binding ActiveDocument.AddedChangeLabel}" Classes="editor-meta plus" IsVisible="{Binding ActiveDocument.HasChangeLabels}" VerticalAlignment="Center" FontWeight="Black" />
                <TextBlock Grid.Column="6" Text="{Binding ActiveDocument.RemovedChangeLabel}" Classes="editor-meta minus" IsVisible="{Binding ActiveDocument.HasChangeLabels}" VerticalAlignment="Center" FontWeight="Black" />
                <TextBlock Grid.Column="7" Text="{Binding ActiveDocument.Status}" Classes="editor-meta" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsChatMode}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ContextControl.ChatWorkspaceTitle}"
                        FontSize="11"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding ContextControl.ChatWorkspaceSubtitle}"
                        Classes="editor-meta"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Text="{Binding ContextControl.PromptTokenomicsLabel}" Classes="scanner-status" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="browser-open-button"
                    Content="Refresh"
                    IsVisible="{Binding ContextControl.IsLocalOrImageGenPromptMode}"
                    Command="{Binding ContextControl.RefreshLocalModelsCommand}"
                    CommandParameter="fast" />
                <Button
                    Grid.Column="1"
                    Classes="browser-open-button"
                    Content="Refresh"
                    IsVisible="{Binding ContextControl.IsChatHeaderCodexStatusVisible}"
                    Command="{Binding ContextControl.RefreshCodexStatusCommand}" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="browser-nav-bar" Padding="6,2" IsVisible="{Binding IsBrowserMode}">
              <Grid ColumnDefinitions="20,20,20,*,20,Auto" ColumnSpacing="3">
                <Button
                    Classes="browser-nav-button"
                    Content="‹"
                    IsEnabled="{Binding BrowserPane.CanGoBack}"
                    Click="OnBrowserBackClick"
                    ToolTip.Tip="Back" />
                <Button
                    Grid.Column="1"
                    Classes="browser-nav-button"
                    Content="›"
                    IsEnabled="{Binding BrowserPane.CanGoForward}"
                    Click="OnBrowserForwardClick"
                    ToolTip.Tip="Forward" />
                <Button
                    Grid.Column="2"
                    Classes="browser-nav-button"
                    Content="↻"
                    Click="OnBrowserRefreshClick"
                    ToolTip.Tip="Reload" />
                <TextBox
                    Grid.Column="3"
                    Classes="browser-url-input"
                    Text="{Binding BrowserPane.UrlText, Mode=TwoWay}"
                    Watermark="https://chatgpt.com"
                    KeyDown="OnBrowserUrlKeyDown" />

                <Button
                    Grid.Column="4"
                    Classes="browser-nav-button"
                    Content="+"
                    Click="OnBrowserNewTabClick"
                    ToolTip.Tip="New tab" />

                <Button
                    Grid.Column="5"
                    Classes="browser-open-button"
                    Content="Go"
                    Click="OnBrowserOpenClick" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsLlmsMode}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Local LLMs" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="header-mini"
                    Content="{Binding ContextControl.LocalLlmOwnershipFilterLabel}"
                    Command="{Binding ContextControl.CycleLocalLlmOwnershipFilterCommand}" />
                <Button
                    Grid.Column="1"
                    Classes="header-mini workspace-update"
                    Classes.active="{Binding ContextControl.IsLlmInfoExpanded}"
                    Content="{Binding ContextControl.LlmInfoToggleLabel}"
                    Command="{Binding ContextControl.ToggleLlmInfoCommand}" />
                <Button
                    Grid.Column="3"
                    Classes="header-mini"
                    Classes.active="{Binding ContextControl.IsLlmFiltersExpanded}"
                    Content="{Binding ContextControl.LlmFiltersToggleLabel}"
                    Command="{Binding ContextControl.ToggleLlmFiltersCommand}" />
                <Button
                    Grid.Column="4"
                    Classes="browser-open-button primary"
                    Content="{Binding ContextControl.OllamaInstallButtonLabel}"
                    ToolTip.Tip="{Binding ContextControl.OllamaInstallCommandLabel}"
                    Command="{Binding ContextControl.InstallOllamaCommand}" />
                <Button
                    Grid.Column="5"
                    Classes="browser-open-button"
                    Content="Open Page"
                    Command="{Binding ContextControl.OpenOllamaDownloadPageCommand}" />
                <Button
                    Grid.Column="6"
                    Classes="browser-open-button"
                    Content="Refresh"
                    Command="{Binding ContextControl.RefreshLocalModelsCommand}" />
                <Button
                    Grid.Column="7"
                    Classes="browser-open-button"
                    Content="Prompt"
                  Command="{Binding ContextControl.OpenPromptCommand}" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsDependenciesMode}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="LLM Dependencies" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ContextControl.DependencySummary}" Classes="editor-meta" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding ContextControl.OllamaModelsDirectoryStatus}" Classes="scanner-status" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="browser-open-button"
                    Content="Refresh"
                    Command="{Binding ContextControl.RefreshLocalModelsCommand}" />
                  <Button
                    Grid.Column="2"
                    Classes="browser-open-button"
                    Content="Open Page"
                    Command="{Binding ContextControl.OpenOllamaDownloadPageCommand}" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsMyStackMode}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="My Stack" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ContextControl.MyStackSummary}" Classes="editor-meta" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding ContextControl.OllamaModelsDirectoryStatus}" Classes="scanner-status" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="header-mini"
                    Classes.active="{Binding ContextControl.IsLlmFiltersExpanded}"
                    Content="{Binding ContextControl.LlmFiltersToggleLabel}"
                    Command="{Binding ContextControl.ToggleLlmFiltersCommand}" />
                <Button
                    Grid.Column="2"
                    Classes="browser-open-button"
                    Content="Refresh"
                    Command="{Binding ContextControl.RefreshLocalModelsCommand}" />
                <Button
                    Grid.Column="3"
                    Classes="browser-open-button"
                    Content="Prompt"
                    Command="{Binding ContextControl.OpenPromptCommand}" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsSkillbookMode}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Skillbook" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ContextControl.SkillbookSummary}" Classes="editor-meta" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding ContextControl.SkillbookProjectPath}" Classes="scanner-status" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="browser-open-button"
                    Content="Info"
                    ToolTip.Tip="Show or hide Skillbook info"
                    Command="{Binding ContextControl.ToggleSkillbookInfoCommand}" />
                <TextBlock Grid.Column="2" Text="{Binding ContextControl.SkillbookGlobalPath}" Classes="path-text" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="pane-header graph-header" Padding="12,10,12,6" IsVisible="{Binding IsProjectGraphMode}">
              <StackPanel Spacing="6">
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,2" VerticalAlignment="Center">
                    <controls:WorkspaceIcon IconKey="graph" Width="18" Height="18" Foreground="{DynamicResource AccentBorderBrush}" />
                    <TextBlock Text="Architecture graph" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="{Binding ProjectGraphSummary}" Classes="graph-header-meta" TextWrapping="Wrap" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Text="{Binding ProjectGraphSelectedLabel}" ToolTip.Tip="{Binding ProjectGraphSelectedLabel}" Classes="graph-header-meta" TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                  <Button Classes="graph-toolbar-button" Command="{Binding OpenProjectGraphSearchCommand}" ToolTip.Tip="Find a node (Ctrl+F)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><controls:WorkspaceIcon IconKey="search" Classes="graph-button-icon" /><TextBlock Text="Find" /></StackPanel>
                  </Button>
                  <Button Classes="graph-toolbar-button" Click="OnProjectGraphExportClick" ToolTip.Tip="Export graph and project details">
                    <StackPanel Orientation="Horizontal" Spacing="6"><controls:WorkspaceIcon IconKey="export" Classes="graph-button-icon" /><TextBlock Text="Export" /></StackPanel>
                  </Button>
                  <Button Classes="graph-toolbar-button" Command="{Binding ToggleProjectGraphLayoutModeCommand}" ToolTip.Tip="Switch generation 1 packing">
                    <StackPanel Orientation="Horizontal" Spacing="6"><controls:WorkspaceIcon IconKey="layout" Classes="graph-button-icon" /><TextBlock Text="{Binding ProjectGraphLayoutToggleLabel}" /></StackPanel>
                  </Button>
                  <Button Classes="graph-toolbar-button" Click="OnProjectGraphFitLayoutClick" ToolTip.Tip="Reset arrangement and fit the graph">
                    <StackPanel Orientation="Horizontal" Spacing="6"><controls:WorkspaceIcon IconKey="fit" Classes="graph-button-icon" /><TextBlock Text="Fit layout" /></StackPanel>
                  </Button>
                  <Button Classes="graph-toolbar-button" Command="{Binding ToggleProjectGraphTreePaneCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><controls:WorkspaceIcon IconKey="tree" Classes="graph-button-icon" /><TextBlock Text="{Binding ProjectGraphTreeToggleLabel}" /></StackPanel>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="Levels" Classes="graph-header-meta" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding ProjectGraphGenerationColors}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectGraphGenerationColorViewModel}">
                          <Button Classes="graph-color-swatch-button" Click="OnProjectGraphColorSwatchClick" ToolTip.Tip="Change this generation's accent color">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{Binding SwatchBrush}" />
                              <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="pane-header" Padding="12,0" IsVisible="{Binding IsProjectScannerMode}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Project scanner" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ProjectScanSummary}" Classes="editor-meta" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding ProjectScanAutoSetupStatus}" Classes="scanner-status" />
                </StackPanel>
                <ToggleButton
                    Grid.Column="1"
                    Classes="browser-open-button scanner-info-button"
                    Content="Info"
                    IsChecked="{Binding ShowProjectScanMetrics, Mode=TwoWay}"
                    ToolTip.Tip="Show or hide project scan counters" />
                <Button
                    Grid.Column="2"
                    Classes="browser-open-button"
                    Content="Copy"
                    Click="OnProjectScannerCopyClick" />
                <Button
                    Grid.Column="3"
                    Classes="browser-open-button"
                    Content="{Binding ProjectScanButtonLabel}"
                    Command="{Binding ScanProjectRulesCommand}"
                    IsEnabled="{Binding CanScanProjectRules}" />
                <Button
                    Grid.Column="4"
                    Classes="browser-open-button primary"
                    Content="Autosetup"
                    Command="{Binding AutoSetupProjectRulesCommand}"
                    IsEnabled="{Binding CanAutoSetupProjectRules}" />
              </Grid>
            </Border>
          </Grid>
</UserControl>
